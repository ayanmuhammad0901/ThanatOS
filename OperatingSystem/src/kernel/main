org 0x0
bits 16

%define ENDL 0x0D, 0x0A
start:

    mov si,msg_hello
    call puts

.halt:
    cli
    hlt


;prints string to screen
puts:
    push si
    push ax

;loops through the string until it reaches a null terminator
.loop:
    lodsb
    or al, al
    jz .done

    mov ah, 0x0E
    int 0x10

    jmp .loop

.done:
    pop ax
    pop si

    ret

msg_hello: db'Hello, World!', ENDL, 0

