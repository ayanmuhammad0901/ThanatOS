
;----------------------------------------------------------------------------------------------------------------------------------------------------------
org 0x7C00
bits 16

%define ENDL 0x0D, 0x0A

;
; FAT12 header
;
jmp short start
nop

bdb_oem:                    db 'MSWIN4.1'           ; 8 bytes
bdb_bytes_per_sector:       dw 512
bdb_sectors_per_cluster:    db 1
bdb_reserved_sectors:       dw 1
bdb_fat_count:              db 2
bdb_dir_entries_count:      dw 0E0h
bdb_total_sectors:          dw 2880
bdb_media_descriptor_type:  db 0F0h
bdb_sectors_per_fat:        dw 9
bdb_sectors_per_track:      dw 18                   ; FIX: 1.44MB floppy has 18 (BIOS value overwrites it at runtime)
bdb_heads:                  dw 2
bdb_hidden_sectors:         dd 0
bdb_large_sector_count:     dd 0

; Extended boot record
ebr_drive_number:           db 0
                            db 0
ebr_signature:              db 29h
ebr_volume_id:              db 12h, 34h, 56h, 78h
ebr_volume_label:           db 'ThanatOS   '        ; FIX: must be exactly 11 bytes
ebr_system_id:              db 'FAT12   '           ; 8 bytes

;
; code goes here
;

start:
    mov ax, 0
    mov ds, ax
    mov es, ax

    mov ss, ax
    mov sp, 0x7C00

    ; some BIOSes load us at 07C0:0000 instead of 0000:7C00; normalise CS
    push es
    push word .after
    retf
.after:

    mov [ebr_drive_number], dl

    mov si, msg_hello
    call puts

    ; read drive parameters from the BIOS
    push es
    mov ah, 08h
    int 13h
    jc floppy_error
    pop es

    and cl, 0x3F
    xor ch, ch
    mov [bdb_sectors_per_track], cx

    inc dh
    mov [bdb_heads], dh

    ; LBA of root directory = reserved + fats * sectors_per_fat
    mov ax, [bdb_sectors_per_fat]
    mov bl, [bdb_fat_count]
    xor bh, bh
    mul bx
    add ax, [bdb_reserved_sectors]
    push ax

    ; size of root directory in sectors = (entries * 32) / bytes_per_sector, rounded up
    mov ax, [bdb_dir_entries_count]     ; FIX: was bdb_sectors_per_fat
    shl ax, 5
    xor dx, dx
    div word [bdb_bytes_per_sector]

    test dx, dx
    jz .root_dir_after                  ; FIX: was 'jz root' (undefined label)
    inc ax

.root_dir_after:

    ; read root directory
    mov cl, al
    pop ax
    mov dl, [ebr_drive_number]
    mov bx, buffer
    call disk_read

    ; search for kernel.bin
    xor bx, bx
    mov di, buffer

.search_kernel:
    mov si, file_kernel_bin
    mov cx, 11
    push di
    repe cmpsb
    pop di
    je .found_kernel

    add di, 32
    inc bx
    cmp bx, [bdb_dir_entries_count]
    jl .search_kernel

    jmp kernel_not_found_error

.found_kernel:

    ; first cluster of the kernel
    mov ax, [di + 26]
    mov [kernel_cluster], ax

    ; load the FAT into memory
    mov ax, [bdb_reserved_sectors]
    mov bx, buffer
    mov cl, [bdb_sectors_per_fat]
    mov dl, [ebr_drive_number]
    call disk_read

    ; read the kernel and follow the cluster chain
    mov bx, KERNEL_LOAD_SEGMENT
    mov es, bx
    mov bx, KERNEL_LOAD_OFFSET

.load_kernel_loop:
    mov ax, [kernel_cluster]
    add ax, 31                          ; first cluster = (cluster - 2) * spc + data start (33)

    mov cl, 1
    mov dl, [ebr_drive_number]
    call disk_read

    add bx, [bdb_bytes_per_sector]

    ; next cluster = FAT[cluster * 3 / 2]
    mov ax, [kernel_cluster]
    mov cx, 3
    mul cx
    mov cx, 2
    div cx                              ; ax = index, dx = cluster % 2

    mov si, buffer
    add si, ax
    mov ax, [ds:si]

    or dx, dx
    jz .even

.odd:
    shr ax, 4
    jmp .next_cluster_after

.even:
    and ax, 0x0FFF

.next_cluster_after:
    cmp ax, 0x0FF8                      ; FIX: was 070FF8 (invalid number)
    jae .read_finish

    mov [kernel_cluster], ax
    jmp .load_kernel_loop

.read_finish:
    mov dl, [ebr_drive_number]

    mov ax, KERNEL_LOAD_SEGMENT
    mov ds, ax
    mov es, ax

    jmp KERNEL_LOAD_SEGMENT:KERNEL_LOAD_OFFSET

;
; Error handlers
;

floppy_error:
    mov si, msg_error
    call puts
    jmp wait_key_and_reboot

kernel_not_found_error:
    mov si, msg_kernel_not_found
    call puts
    jmp wait_key_and_reboot

wait_key_and_reboot:
    mov ah, 0
    int 16h                             ; wait for keypress
    jmp 0FFFFh:0                        ; jump to BIOS entry (reboot)

;
; Prints a null-terminated string.
; Params: ds:si = string
;
puts:                                   ; FIX: this routine was missing entirely
    push si
    push ax

.loop:
    lodsb
    or al, al
    jz .done

    mov ah, 0x0E
    mov bh, 0
    int 0x10
    jmp .loop

.done:
    pop ax
    pop si
    ret

;
; Disk routines
;

; Converts an LBA address to CHS.
; Params:  ax = LBA
; Returns: cx[0-5] = sector, cx[6-15] = cylinder, dh = head
lba_to_chs:

    push ax
    push dx

    xor dx, dx
    div word [bdb_sectors_per_track]    ; ax = LBA / SPT, dx = LBA % SPT

    inc dx
    mov cx, dx                          ; cx = sector

    xor dx, dx
    div word [bdb_heads]                ; ax = cylinder, dx = head

    mov dh, dl                          ; dh = head
    mov ch, al                          ; ch = cylinder (low 8 bits)
    shl ah, 6
    or cl, ah                           ; cylinder high 2 bits into cl

    pop ax
    mov dl, al                          ; restore dl only
    pop ax
    ret

; Reads sectors from a disk.
; Params: ax = LBA, cl = sector count, dl = drive, es:bx = destination
disk_read:

    push ax
    push bx
    push cx
    push dx
    push di

    push cx
    call lba_to_chs
    pop ax                              ; al = sector count

    mov ah, 02h
    mov di, 3                           ; retry 3 times

.retry:
    pusha
    stc
    int 13h
    jnc .done                           ; FIX: was 'jmp .done' (retries never ran)

    popa
    call disk_reset

    dec di
    test di, di
    jnz .retry

.fail:
    jmp floppy_error

.done:
    popa

    pop di
    pop dx
    pop cx
    pop bx
    pop ax
    ret

; Resets the disk controller. Params: dl = drive
disk_reset:
    pusha
    mov ah, 0
    stc
    int 13h
    jc floppy_error
    popa
    ret

msg_hello:              db '----ThanatOS----', ENDL, 0
msg_error:              db 'Floppy read error!', ENDL, 0
msg_kernel_not_found:   db 'KERNEL.BIN file not found!', ENDL, 0
file_kernel_bin:        db 'KERNEL  BIN'
kernel_cluster:         dw 0

KERNEL_LOAD_SEGMENT     equ 0x2000
KERNEL_LOAD_OFFSET      equ 0

times 510 - ($ - $$) db 0
dw 0AA55h

buffer:
